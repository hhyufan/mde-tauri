{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MokiDown Setup",
  "version": "0.1.3",
  "identifier": "com.mokidown.installer",
  "build": {
    "beforeDevCommand": "npm --prefix .. run installer:dev",
    "devUrl": "http://localhost:1423",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MokiDown 安装",
        "width": 960,
        "height": 660,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../src-tauri/icons/icon.ico"
    ]
  }
}
