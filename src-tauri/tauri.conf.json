{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mokidown",
  "version": "0.1.4",
  "identifier": "com.mokidown.app",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1421",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MokiDown",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "center": true,
        "visible": false,
        "focus": false,
        "transparent": false,
        "decorations": false,
        "shadow": false,
        "devtools": true,
        "dragDropEnabled": true,
        "backgroundColor": "#f5f5f7"
      },
      {
        "label": "splash",
        "title": "MokiDown",
        "url": "splash/index.html",
        "width": 640,
        "height": 400,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "transparent": false,
        "decorations": false,
        "shadow": false,
        "backgroundColor": "#f5f5f7"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost https: http://localhost:* ws://localhost:*; img-src 'self' asset: http://asset.localhost blob: data: https:; style-src 'self' 'unsafe-inline'; style-src-elem 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'"
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "dialog": null,
    "store": null,
    "updater": {
      "endpoints": [
        "https://mokidown-updates.oss-cn-hangzhou.aliyuncs.com/updates/latest.json",
        "https://mokidown-updates.oss-accelerate.aliyuncs.com/updates/latest.json",
        "https://github.com/hhyufan/mokidown/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyRjE4MTI3RjEzNDc1QkMKUldTOGRUVHhKNEh4UW8rVDBOU1QzS1c2a29nZTlsY2VyTjRSM3hWQ1A2WW5jV0RoLzBOVzRXa2EK"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "template": "windows/installer.nsi",
        "installerHooks": "windows/progress.nsh",
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.0-37",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mdwn",
          "mkd",
          "mkdn"
        ],
        "name": "Markdown File",
        "description": "Markdown document"
      }
    ]
  }
}
