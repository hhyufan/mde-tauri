{
  "name": "mde",
  "private": true,
  "version": "0.1.0",
  "description": "A cross-platform Markdown editor based on Tauri",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "format:check": "prettier --check eslint.config.js vitest.config.js vitest.setup.js scripts/check-bundle-budget.mjs scripts/sync-version.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "check": "npm run lint && npm run test && npm run build && npm run check:bundle",
    "preview": "vite preview",
    "generate:showcase-data": "node scripts/generate-showcase-data.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:CARGO_TARGET_DIR = (Resolve-Path 'src-tauri').Path + '\\target'; tauri build --bundles msi nsis\"",
    "tauri:build:nsis": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:CARGO_TARGET_DIR = (Resolve-Path 'src-tauri').Path + '\\target'; tauri build --bundles nsis\"",
    "tauri:android:init": "tauri android init",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build",
    "tauri:android:build:debug": "tauri android build --debug --apk"
  },
  "dependencies": {
    "@ant-design/icons": "^5.2.6",
    "@antv/g2": "^5.4.8",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.3",
    "@milkdown/kit": "^7.21.1",
    "@milkdown/plugin-math": "^7.5.9",
    "@milkdown/react": "^7.21.1",
    "@shikijs/monaco": "^4.0.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "antd": "^5.27.5",
    "axios": "^1.15.0",
    "i18next": "^25.4.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "katex": "^0.16.47",
    "mermaid": "^11.14.0",
    "monaco-editor": "^0.52.2",
    "monaco-editor-nls-adapter": "^2.1.1",
    "pako": "^2.1.0",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-diff-viewer": "^3.1.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.7.3",
    "react-markdown": "^10.1.0",
    "react-material-vscode-icons": "^0.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.0.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.86.1",
    "terser": "^5.44.0",
    "vite": "^6.2.4",
    "vitest": "^4.1.11"
  }
}
