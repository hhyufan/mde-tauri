{
  "name": "mokidown",
  "private": true,
  "version": "0.1.3",
  "description": "A cross-platform Markdown editor based on Tauri",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "format:check": "prettier --check eslint.config.js vitest.config.js vitest.setup.js scripts/check-bundle-budget.mjs scripts/check-installer-bundle-budget.mjs scripts/sync-version.mjs",
    "test": "vitest run && node --test \"scripts/*.test.mjs\"",
    "test:watch": "vitest",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:installer-bundle": "node scripts/check-installer-bundle-budget.mjs",
    "version:sync": "node scripts/sync-version.mjs",
    "check:rust": "node scripts/rust.mjs fmt --manifest-path src-tauri/Cargo.toml -- --check && node scripts/rust.mjs clippy --manifest-path src-tauri/Cargo.toml --locked -- -D warnings",
    "check": "npm run lint && npm run test && npm run test:build-tools && npm run check:i18n && npm run format:check && npm run build && npm run check:bundle && npm run installer:build && npm run check:installer-bundle && npm run check:rust",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "check:rust": "node scripts/rust.mjs",
    "test:rust": "node scripts/rust.mjs test --manifest-path src-tauri/Cargo.toml --lib --locked",
    "check:hotkey-probe": "node scripts/rust.mjs run --manifest-path src-tauri/Cargo.toml --example hotkey_probe_check",
    "preview": "vite preview",
    "preview:editor:production": "node scripts/preview-production-editor.mjs",
    "generate:showcase-data": "node scripts/generate-showcase-data.mjs",
    "test:build-tools": "node --test scripts/windows-msvc.test.mjs scripts/startup-splash.test.mjs scripts/create-update-manifest.test.mjs",
    "tauri": "node scripts/tauri.mjs",
    "tauri:dev": "node scripts/tauri.mjs dev",
    "tauri:build": "node scripts/build-react-installer.mjs --with-msi",
    "tauri:build:nsis": "node scripts/build-react-installer.mjs",
    "installer:dev": "vite --config installer/vite.config.mjs",
    "installer:build": "vite build --config installer/vite.config.mjs",
    "installer:bundle": "node scripts/build-react-installer.mjs",
    "installer:tauri:dev": "node scripts/react-installer.mjs dev",
    "tauri:android:init": "tauri android init",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build",
    "tauri:android:build:debug": "tauri android build --debug --apk",
    "test:e2e": "playwright test --config tests/playwright.config.mjs",
    "test:e2e:production": "playwright test --config tests/playwright.production.config.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.2.6",
    "@antv/g2": "^5.4.8",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.3",
    "@milkdown/kit": "^7.21.1",
    "@milkdown/plugin-math": "^7.5.9",
    "@milkdown/react": "^7.21.1",
    "@shikijs/monaco": "^4.0.2",
    "@tauri-apps/api": "~2.10.1",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2",
    "@tauri-apps/plugin-updater": "~2.10.1",
    "antd": "^5.27.5",
    "axios": "^1.15.0",
    "i18next": "^25.4.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "katex": "^0.16.47",
    "mermaid": "^11.14.0",
    "monaco-editor": "^0.52.2",
    "pako": "^2.1.0",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-diff-viewer": "^3.1.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.7.3",
    "react-markdown": "^10.1.0",
    "react-material-vscode-icons": "^0.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.0.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.86.1",
    "terser": "^5.44.0",
    "vite": "^6.2.4",
    "vitest": "^4.1.11"
  }
}
